# 可选：覆盖 GitHub 仓库名推导出的子路径。
# 项目页通常无需设置；自定义域名或本地调试固定子路径时可设置，例如 /equity-composition
# NEXT_PUBLIC_BASE_PATH=

# 可选：构建时注入各角色的 SHA-256 密码哈希（十六进制）。
# 生成方式：node -e "console.log(require('crypto').createHash('sha256').update('你的密码').digest('hex'))"
# 未设置时使用演示密码：admin123 / partner123 / investor123
# NEXT_PUBLIC_ADMIN_PASSWORD_HASH=
# NEXT_PUBLIC_PARTNER_PASSWORD_HASH=
# NEXT_PUBLIC_INVESTOR_PASSWORD_HASH=

# 默认在登录页展示演示密码提示；注入自定义哈希或设为 false 可关闭
# NEXT_PUBLIC_DEMO_MODE=false
